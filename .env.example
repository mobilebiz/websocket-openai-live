# ngrok / Fly.io で払い出されたホスト名 (https:// は付けても付けなくてもよい)
# Vonage の WebSocket は wss:// のみ対応のため http:// は指定できない
SERVER_URL=

# OpenAI
OPENAI_API_KEY=
# 音声会話を担当するモデル
OPENAI_MODEL=gpt-live-1
OPENAI_VOICE=marin
# 推論とツールを担当するバックエンドモデル (responses delegation)
OPENAI_BACKEND_MODEL=gpt-5.6-luna

# Vonage と GPT-Live で共通のサンプリングレート (16000 か 24000)
# 揃えておくとリサンプリングが不要になる
AUDIO_RATE=16000

# info / debug など
LOG_LEVEL=info
PORT=3000
