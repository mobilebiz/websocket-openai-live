# Fly.io で払い出されたホスト名 (例: websocket-openai-live.fly.dev)
# https:// は付けても付けなくてもよい
# Vonage の WebSocket は wss:// のみ対応のため http:// は指定できない
SERVER_URL=

# OpenAI
OPENAI_API_KEY=
# 音声会話を担当するモデル
OPENAI_MODEL=gpt-live-1
OPENAI_VOICE=marin
# 推論とツールを担当するバックエンドモデル (responses delegation)
OPENAI_BACKEND_MODEL=gpt-5.6-luna

# 委譲した処理の応答速度に効く設定。空にすると指定しない
# auto / default / flex / priority
OPENAI_SERVICE_TIER=priority
# minimal / low / medium / high
OPENAI_REASONING_EFFORT=low
# 委譲先の出力上限 (最小 16)。空なら指定しない
OPENAI_MAX_OUTPUT_TOKENS=

# get_weather で使う OpenWeatherMap の API キー
OPEN_WEATHER_API_KEY=

# Vonage と GPT-Live で共通のサンプリングレート (16000 か 24000)
# 揃えておくとリサンプリングが不要になる
AUDIO_RATE=16000

# info / debug など
LOG_LEVEL=info
PORT=3000
